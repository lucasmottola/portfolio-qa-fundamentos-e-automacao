      "name": "Login",
      "item": [
        {
          "name": "Login — credenciais inválidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code é 401 para credenciais inválidas\", function () {\n  pm.response.to.have.status(401);\n});\n\npm.test(\"Mensagem de erro está correta\", function () {\n  var jsonData = pm.response.json();\n  pm.expect(jsonData.message).to.eql(\"Email e/ou senha inválidos\");\n});\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"fulano@qa.com\",\n  \"password\": \"teste123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login — credenciais válidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code é 200 OK\", function () {\n  pm.response.to.have.status(200);\n});\n\npm.test(\"Login confirma sucesso e retorna token\", function () {\n  var jsonData = pm.response.json();\n\n  pm.expect(jsonData.message).to.eql(\"Login realizado com sucesso\");\n  pm.expect(jsonData.authorization).to.be.a(\"string\");\n  pm.expect(jsonData.authorization.length).to.be.above(0);\n\n  var token = jsonData.authorization.replace(/^Bearer\\s+/i, \"\");\n    pm.environment.set(\"token\", token);\n\n\n  pm.test(\"Token salvo no ambiente\", function () {\n  var tokenSalvo = pm.environment.get(\"token\");\n  pm.expect(tokenSalvo).to.be.a(\"string\");\n  pm.expect(tokenSalvo).to.not.be.empty;\n});\n});\n"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"fulano@qa.com\",\n  \"password\": \"teste\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
      ]
