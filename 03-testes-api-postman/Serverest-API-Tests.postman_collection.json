              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code é 400 Bad Request\", function () {\n  pm.response.to.have.status(400);\n});\n\npm.test(\"Resposta informa que email é obrigatório\", function () {\n  var jsonData = pm.response.json();\n\n  pm.expect(jsonData).to.have.property(\"email\");\n  pm.expect(jsonData.email).to.be.a(\"string\");\n  pm.expect(jsonData.email).to.eql(\"email é obrigatório\");\n});\n\nvar schemaErroEmail = {\n  type: \"object\",\n  required: [\"email\"],\n  properties: {\n    email: {\n      type: \"string\"\n    }\n  }\n};\n\npm.test(\"Resposta de erro segue o schema de email obrigatório\", function () {\n  pm.response.to.have.jsonSchema(schemaErroEmail);\n});\n"
                ]
